---
---
<section id="home" class="py-20 md:py-32 flex flex-col-reverse md:flex-row items-center justify-between gap-10 max-w-7xl mx-auto px-6">

    <div class="flex-1 flex flex-col items-start text-left w-full z-10">
        <h2 class="text-3xl md:text-4xl font-semibold text-port-text mb-2 flex items-center">
            Hola <span class="text-port-accent ml-2 text-5xl drop-shadow-[0_0_10px_rgba(255,107,88,0.8)]">.</span>
        </h2>
        <h3 class="text-xl md:text-2xl text-port-gray mb-4 font-light">
            Soy Joaquín Huaranga
        </h3>
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-port-text leading-tight mb-8">
            Desarrollador <br class="hidden md:block" />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-port-text via-port-gray to-port-gray">Web y Móvil</span>
        </h1>

        <div class="flex flex-wrap gap-4 mt-2">
            <a href="#projects" class="bg-port-accent text-port-bg font-bold py-3 px-8 hover:bg-port-accent/90 hover:shadow-[0_0_20px_rgba(255,107,88,0.4)] transition-all rounded-sm duration-300">
                Ver proyectos
            </a>
            <a href="/CV_JoaquinAlexandroHuarangaOrihuela.pdf" target="_blank" class="border border-port-gray text-port-text py-3 px-8 hover:border-port-accent hover:text-port-accent hover:bg-port-accent/5 transition-all rounded-sm duration-300">
                Mi currículum
            </a>
        </div>
    </div>

    <div class="flex-1 flex justify-center md:justify-end w-full mt-16 md:mt-0 relative">

        <div class="relative w-72 h-72 md:w-[420px] md:h-[420px] flex items-center justify-center">

            <div class="absolute -top-10 -left-4 md:-top-12 md:-left-8 text-6xl md:text-8xl font-mono text-port-accent opacity-30 font-light select-none tracking-tighter hover:opacity-70 transition-opacity duration-500 cursor-default">
                &lt;
            </div>

            <div class="absolute -bottom-4 -right-4 md:-bottom-8 md:-right-8 text-6xl md:text-8xl font-mono text-port-accent opacity-30 font-light select-none tracking-tighter hover:opacity-70 transition-opacity duration-500 cursor-default">
                &gt;
            </div>

            <div class="absolute w-64 h-64 md:w-[380px] md:h-[380px] border-[8px] md:border-[12px] border-port-accent/70 rounded-full z-0 shadow-[0_0_60px_rgba(255,107,88,0.25)]"></div>

            <img
                    src="/perfil.png"
                    alt="Joaquín Huaranga"
                    class="relative z-10 w-[100%] md:w-[110%] max-w-lg h-auto object-contain drop-shadow-[0_20px_30px_rgba(0,0,0,0.5)] hover:scale-105 transition-transform duration-700 ease-out -mt-12 [mask-image:linear-gradient(to_bottom,black_75%,transparent_100%)]"
            />

        </div>
    </div>

</section>