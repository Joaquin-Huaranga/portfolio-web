---
const technologies = [
    "React",
    "React Native",
    "Next.js",
    "Astro",
    "C# .NET",
    "Firebase",
    "Tailwind CSS",
    "Node.js",
    "Git"
];
---
<div class="w-full border-y border-port-card py-6 md:py-8 mb-20 bg-port-bg">

    <div class="max-w-7xl mx-auto px-6 flex flex-wrap justify-center md:justify-between items-center gap-6 md:gap-4 text-port-gray font-medium text-sm md:text-base tracking-wider uppercase">
        {technologies.map((tech) => (
                <span class="hover:text-port-accent transition-colors duration-300 cursor-default">
        {tech}
      </span>
        ))}
    </div>

</div>